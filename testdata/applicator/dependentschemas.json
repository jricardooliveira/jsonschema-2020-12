    {"description":"empty object","data":{},"valid":true},
    {"description":"array ignored","data":["foo"],"valid":true},
    {"description":"string ignored","data":"foo","valid":true},
    {"description":"null ignored","data":null,"valid":true}]},
  {"spec":"core 10.2.2.4","description":"dependentSchemas boolean schemas","schema":{"dependentSchemas":{"a":true,"b":false}},"tests":[
    {"description":"no triggers","data":{"c":1},"valid":true},
    {"description":"true trigger","data":{"a":1},"valid":true},
    {"description":"false trigger","data":{"b":1},"valid":false}]},
  {"spec":"core 10.2.2.4","description":"dependentSchemas applies to the whole object","schema":{"dependentSchemas":{"foo":{"type":"object"}}},"tests":[
