[
  {
    "spec": "2020-12 core, section 4.3.2 Boolean JSON Schemas",
    "description": "schema true accepts every document",
    "schema": true,
    "tests": [
      {"description": "null", "data": null, "valid": true},
      {"description": "number", "data": 1, "valid": true},
      {"description": "string", "data": "s", "valid": true},
      {"description": "array", "data": [1, 2], "valid": true},
      {"description": "object", "data": {"a": {}}, "valid": true}
    ]
  },
  {
    "spec": "2020-12 core, section 4.3.2 Boolean JSON Schemas",
    "description": "schema false rejects every document",
    "schema": false,
    "tests": [
      {"description": "null", "data": null, "valid": false},
      {"description": "boolean", "data": true, "valid": false},
      {"description": "number", "data": 1, "valid": false},
      {"description": "string", "data": "s", "valid": false},
      {"description": "array", "data": [], "valid": false},
      {"description": "object", "data": {}, "valid": false}
    ]
  }
]
